+static double approach(double current, double target, double max_step)
+{
+    if (target > current + max_step) return current + max_step;
+    if (target < current - max_step) return current - max_step;
+    return target;
+}
+
+void QuadrupedController::smoothVelocity_(double dt)
+{
+    // Clamp dt: a paused simulation or a stalled timer must not produce a jump.
+    dt = std::min(std::max(dt, 0.0), 0.05);
+    applied_vel_.linear.x = approach(applied_vel_.linear.x, req_vel_.linear.x, max_linear_accel_ * dt);
+    applied_vel_.linear.y = approach(applied_vel_.linear.y, req_vel_.linear.y, max_linear_accel_ * dt);
+    applied_vel_.angular.z = approach(applied_vel_.angular.z, req_vel_.angular.z, max_angular_accel_ * dt);
+}
