# ROS 2 workspace folders
build/*
install/*
log/*

# Local Gazebo model collection (large external simulation assets)
/config/gazebo/

# Imported ROS packages used only by the local Gazebo simulation
/src/champ/
/src/champ_base/
/src/champ_config/
/src/champ_msgs/
/src/dottorcane_description/
/src/go2_description/
/src/ldc25_sim/
/src/ros_gz_republish/
/src/velodyne_description/
/src/zed_description/

# AgenticROS local state and secrets
.agenticros/
.pnpm-store/
config/agenticros.local.json
.env
.env.*
!.env.example

# Python build products
.venv/
__pycache__/
*.py[cod]

# Uncomment the following to avoid pushing personal configurations
# .vscode/

docs/index.html
# Vision evaluation: captured frames, depth and masks (~150 MB, regenerable with capture.py / gt2.py)
/scripts/vision_eval/data/frames/
/scripts/vision_eval/data/masks/
/scripts/vision_eval/data/extra_frames/
/scripts/vision_eval/**/*.log
/scripts/vision_eval/**/*.json
/scripts/vision_eval/**/*.jsonl
/scripts/vision_eval/results/closed_loop/
/scripts/vision_eval/results/imu_check/
# Ground truth of the house topology: tracked (evaluation only, never read by the agent)
!/scripts/vision_eval/house_topology.json
