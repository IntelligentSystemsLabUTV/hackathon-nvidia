{
  "name": "@hackathon-nvidia/go2-nav2",
  "version": "0.1.0",
  "private": true,
  "description": "Nav2 capabilities of the Go2 Gazebo simulation, declared for AgenticROS (no code: the robot side is go2_sim_worlds).",
  "agenticros": {
    "id": "go2-nav2",
    "capabilities": [
      {
        "id": "navigate_to",
        "verb": "navigate",
        "description": "Navigate to a pose in the map frame with Nav2 (global plan on the map, obstacle avoidance, AgenticROS speed limits). Used by ros2_navigate_to_place.",
        "inputs": {
          "x": { "type": "number", "description": "Map-frame x [m]." },
          "y": { "type": "number", "description": "Map-frame y [m]." },
          "yaw": { "type": "number", "description": "Map-frame yaw [rad].", "optional": true },
          "frame_id": { "type": "string", "description": "Frame of the pose.", "optional": true, "default": "map" }
        },
        "outputs": {
          "success": { "type": "boolean" },
          "status": { "type": "string", "description": "succeeded, aborted, canceled or rejected." }
        },
        "interruptible": true,
        "blocks_base": true,
        "requires": ["base"],
        "implementation": {
          "kind": "external_ros_node",
          "package": "go2_sim_worlds",
          "launch": "ros2 launch go2_sim_worlds go2_sim.launch.py world:=house nav:=map",
          "action": "navigate_to_pose",
          "msg_type": "nav2_msgs/action/NavigateToPose"
        }
      }
    ]
  }
}
