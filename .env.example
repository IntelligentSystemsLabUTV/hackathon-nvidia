# Copy this file to .env and insert a Token Factory API key.
NEBIUS_API_KEY=

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Kimi-K2.6 returns target bounding boxes; openbmb/MiniCPM-V-4_5 works with 9 numbered columns.
NEBIUS_VISION_MODEL=moonshotai/Kimi-K2.6
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional goal-loop tuning (defaults shown). scripts/run_nebius_agent.sh sets the
# robot defaults (camera, lidar depth, IMU, Nav2 motions) for GO2_TARGET=sim|real.
# NEBIUS_MAX_STEPS=30
# NEBIUS_MAX_SECONDS=300
# NEBIUS_DETECTION_MIN_CONFIDENCE=0.35
# NEBIUS_POLICY=llm            # "auto" = deterministic policy only, Nemotron just parses the request
# NEBIUS_PERCEPTION=vlm        # default: the vision model localizes every target; "yolo" adds tiled YOLO for COCO targets
# NEBIUS_VISION_GROUNDING=box  # force "box" or "columns" for a vision model without a profile
# NEBIUS_FALLBACK_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_FALLBACK_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
