# Copy this file to .env and insert a Token Factory API key.
NEBIUS_API_KEY=

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Kimi-K2.6 returns target bounding boxes; openbmb/MiniCPM-V-4_5 works with 9 numbered columns.
NEBIUS_VISION_MODEL=moonshotai/Kimi-K2.6
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional goal-loop tuning (defaults shown). scripts/run_nebius_agent.sh also
# sets simulation defaults for the depth topic, camera HFOV and motion efficiency.
# NEBIUS_MAX_STEPS=30
# NEBIUS_MAX_SECONDS=300
# NEBIUS_STOP_DISTANCE_M=1.0
# NEBIUS_DETECTION_MIN_CONFIDENCE=0.35
# NEBIUS_POLICY=llm            # "auto" = deterministic policy only, for debugging
# NEBIUS_PERCEPTION=yolo       # "vlm" = no YOLO, the vision model localizes every target
# NEBIUS_VISION_GROUNDING=box  # force "box" or "columns" for a vision model without a profile
# NEBIUS_CAMERA_HEIGHT_M=0.385  # camera height, used to spot depth readings of occluding objects
# NEBIUS_DEPTH_TOPIC=/dottorcane/slam/zed_x_driver/depth_distances
# NEBIUS_CAMERA_HFOV_DEG=110
# NEBIUS_TURN_EFFICIENCY=0.65
# NEBIUS_FORWARD_EFFICIENCY=0.7
