# Copy this file to .env and insert a Token Factory API key.
NEBIUS_API_KEY=

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional comma-separated override. The default exposes only the tools needed
# by the Gazebo perception/navigation prototype to reduce LLM latency.
# NEBIUS_AGENTICROS_TOOLS=ros2_move_for,ros2_action_goal,ros2_camera_snapshot,ros2_estop
